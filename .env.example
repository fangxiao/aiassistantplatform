# agentplatform 环境变量样例(复制为 .env 使用;.env 不入库)
# 本地非 docker 运行默认值见 agentplatform/config.py

# PostgreSQL(docker-compose 内主机名为服务名 pg)
POSTGRES_USER=agentplatform
POSTGRES_PASSWORD=agentplatform
POSTGRES_DB=agentplatform
# DATABASE_URL=postgresql+asyncpg://agentplatform:agentplatform@localhost:5432/agentplatform

# Redis
REDIS_URL=redis://localhost:6379/0

# 安全
SECRET_KEY=change-me

# LLM 端点(管理员配置,M3 接入时使用)
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=sk-xxx
# MODEL=glm-5.2

# 前端(浏览器访问后端 API 的地址)
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
